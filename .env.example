# Copy this file to .env and fill in the values. Never commit or share .env.

# 1 = local development (shows detailed errors). Always 0 on a live server.
VAXSAFE_DEBUG=0

# A long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
VAXSAFE_SECRET_KEY=

# Comma-separated host names the site is served from.
# On PythonAnywhere: yourusername.pythonanywhere.com
VAXSAFE_ALLOWED_HOSTS=yourusername.pythonanywhere.com

# Optional. Leave as they are unless you know you need to change them.
# VAXSAFE_SSL_REDIRECT=0     # set to 1 only if the host does not redirect to HTTPS for you
# VAXSAFE_HSTS_SECONDS=0     # e.g. 31536000 once HTTPS is confirmed working
# VAXSAFE_SECURE_COOKIES=1  # set to 0 only when serving over plain HTTP on a local network
